{
  "entities": {
    "session": {
      "description": "User conversational chat sessions and interactions",
      "fields": {
        "session_id": "string",
        "employee_id": "string",
        "created_at": "string",
        "last_accessed_at": "string",
        "history": "array"
      }
    },
    "checklist": {
      "description": "Employee onboarding tasks and completion state",
      "fields": {
        "employee_id": "string",
        "track": "string",
        "tasks": "array",
        "completed_count": "number",
        "total_count": "number",
        "updated_at": "string"
      }
    },
    "timesheet": {
      "description": "Weekly submitted timesheet entries and approvals",
      "fields": {
        "timesheet_id": "string",
        "employee_id": "string",
        "hours": "number",
        "notes": "string",
        "status": "string",
        "salesforce_id": "string",
        "submitted_at": "string"
      }
    },
    "incident": {
      "description": "Reported IT and platform incidents with Jira tracking",
      "fields": {
        "incident_id": "string",
        "employee_id": "string",
        "category": "string",
        "summary": "string",
        "severity": "string",
        "status": "string",
        "assigned_team": "string",
        "jira_key": "string",
        "jira_url": "string",
        "created_at": "string"
      }
    },
    "employee": {
      "description": "Employee profile, organization mapping, and role",
      "fields": {
        "employee_id": "string",
        "name": "string",
        "email": "string",
        "department": "string",
        "team": "string",
        "job_role": "string",
        "authorization_role": "string",
        "assigned_buddy_name": "string",
        "assigned_buddy_email": "string"
      }
    },
    "knowledgeInsight": {
      "description": "Recent knowledge mesh documentation and policy updates",
      "fields": {
        "insight_id": "string",
        "title": "string",
        "team": "string",
        "access_level": "string",
        "summary": "string",
        "doc_type": "string",
        "gcs_uri": "string",
        "updated_at": "string"
      }
    }
  },
  "firestore": {
    "/sessions/{sessionId}": {
      "entity": "session",
      "indexes": []
    },
    "/checklists/{employeeId}": {
      "entity": "checklist",
      "indexes": []
    },
    "/timesheets/{timesheetId}": {
      "entity": "timesheet",
      "indexes": []
    },
    "/incidents/{incidentId}": {
      "entity": "incident",
      "indexes": []
    },
    "/employees/{employeeId}": {
      "entity": "employee",
      "indexes": []
    },
    "/knowledge_insights/{insightId}": {
      "entity": "knowledgeInsight",
      "indexes": []
    }
  }
}
